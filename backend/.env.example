# For Docker Compose. Replace both password occurrences with the same URL-safe value.
POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgresql+psycopg2://livrusp:local-dev-only@db:5432/livrusp
# Set with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
DEMO_BILLING=false
